#include <Arduino.h>
#include "model_parameters.h"

// compress_weights.pyが生成したcoo/model_parameters.hを同じフォルダへコピーする。
#if !defined(MODEL_STORAGE_COO) || defined(MODEL_STORAGE_CSR)
#error "COO header required: copy coo/model_parameters.h generated by compress_weights.py"
#else

// 手動で次元数を変更せず、重みヘッダーの構成に合わせる。
constexpr uint32_t INPUT_SIZE = MODEL_INPUT_SIZE;
constexpr uint32_t HIDDEN_SIZE1 = MODEL_HIDDEN_SIZE1;
constexpr uint32_t HIDDEN_SIZE2 = MODEL_HIDDEN_SIZE2;
constexpr uint32_t OUTPUT_SIZE = MODEL_OUTPUT_SIZE;

static_assert(INPUT_SIZE == 3 && OUTPUT_SIZE == 3, "RGB model required");
static_assert(HIDDEN_SIZE1 > 0 && HIDDEN_SIZE2 > 0, "Hidden sizes must be positive");
static_assert(sizeof(bias_1) / sizeof(bias_1[0]) == HIDDEN_SIZE1, "bias_1 size mismatch");
static_assert(sizeof(bias_2) / sizeof(bias_2[0]) == HIDDEN_SIZE2, "bias_2 size mismatch");
static_assert(sizeof(weight_3) / sizeof(weight_3[0]) == OUTPUT_SIZE * HIDDEN_SIZE2, "weight_3 size mismatch");
static_assert(sizeof(bias_3) / sizeof(bias_3[0]) == OUTPUT_SIZE, "bias_3 size mismatch");
static_assert(sizeof(weight_1_values) / sizeof(weight_1_values[0]) == (WEIGHT_1_NNZ ? WEIGHT_1_NNZ : 1), "weight_1 values mismatch");
static_assert(sizeof(weight_1_rows) / sizeof(weight_1_rows[0]) == (WEIGHT_1_NNZ ? WEIGHT_1_NNZ : 1), "weight_1 rows mismatch");
static_assert(sizeof(weight_1_cols) / sizeof(weight_1_cols[0]) == (WEIGHT_1_NNZ ? WEIGHT_1_NNZ : 1), "weight_1 cols mismatch");
static_assert(sizeof(weight_2_values) / sizeof(weight_2_values[0]) == (WEIGHT_2_NNZ ? WEIGHT_2_NNZ : 1), "weight_2 values mismatch");
static_assert(sizeof(weight_2_rows) / sizeof(weight_2_rows[0]) == (WEIGHT_2_NNZ ? WEIGHT_2_NNZ : 1), "weight_2 rows mismatch");
static_assert(sizeof(weight_2_cols) / sizeof(weight_2_cols[0]) == (WEIGHT_2_NNZ ? WEIGHT_2_NNZ : 1), "weight_2 cols mismatch");

// 計測区間の外で呼び、索引が中間配列の範囲内か確認する。
bool validateSparseModel() {
    for (uint32_t k = 0; k < WEIGHT_1_NNZ; ++k) {
        if (weight_1_rows[k] >= HIDDEN_SIZE1 || weight_1_cols[k] >= INPUT_SIZE) return false;
    }
    for (uint32_t k = 0; k < WEIGHT_2_NNZ; ++k) {
        if (weight_2_rows[k] >= HIDDEN_SIZE2 || weight_2_cols[k] >= HIDDEN_SIZE1) return false;
    }
    return true;
}

void predict(const float input[INPUT_SIZE], float output[OUTPUT_SIZE]) {
    float layer1[HIDDEN_SIZE1];
    float layer2[HIDDEN_SIZE2];

    // 第1層：バイアスで初期化し、COOの非ゼロ要素だけ積和する。
    for (uint32_t row = 0; row < HIDDEN_SIZE1; ++row) layer1[row] = bias_1[row];
    for (uint32_t k = 0; k < WEIGHT_1_NNZ; ++k) {
        layer1[weight_1_rows[k]] += weight_1_values[k] * input[weight_1_cols[k]];
    }
    for (uint32_t row = 0; row < HIDDEN_SIZE1; ++row) {
        if (layer1[row] < 0.0f) layer1[row] = 0.0f;
    }

    // 第2層もCOO配列を直接参照する。通常の重み行列へ復元しない。
    for (uint32_t row = 0; row < HIDDEN_SIZE2; ++row) layer2[row] = bias_2[row];
    for (uint32_t k = 0; k < WEIGHT_2_NNZ; ++k) {
        layer2[weight_2_rows[k]] += weight_2_values[k] * layer1[weight_2_cols[k]];
    }
    for (uint32_t row = 0; row < HIDDEN_SIZE2; ++row) {
        if (layer2[row] < 0.0f) layer2[row] = 0.0f;
    }

    // 第3層の重みとバイアスは非圧縮のまま。出力層にはReLUを使わない。
    for (uint32_t row = 0; row < OUTPUT_SIZE; ++row) {
        output[row] = bias_3[row];
        for (uint32_t col = 0; col < HIDDEN_SIZE2; ++col) {
            output[row] += weight_3[row * HIDDEN_SIZE2 + col] * layer2[col];
        }
    }
}

#include "measurement.h"

void setup() { measurementSetup(); }
void loop() { measurementLoop(); }

#endif
